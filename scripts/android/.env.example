# scripts/android/.env にコピーし、4 つのパスワードを記入してください。
# 値は文字列として読み込みます。シェルの変数展開やコマンド実行は行いません。
# 値の先頭または末尾に空白がある場合は、全体を引用符で囲んでください。
PRELIS_PLAY_STORE_PASSWORD=
PRELIS_PLAY_KEY_PASSWORD=
PRELIS_APP_STORE_PASSWORD=
PRELIS_APP_KEY_PASSWORD=

# 任意: 既定値は ~/keys/play-upload.jks、別名 play-upload です。
# PRELIS_PLAY_KEYSTORE=/absolute/path/to/play-upload.jks
# PRELIS_PLAY_KEY_ALIAS=play-upload

# 任意: 既定値は ~/keys/app-signing.jks、別名 app-signing です。
# PRELIS_APP_KEYSTORE=/absolute/path/to/app-signing.jks
# PRELIS_APP_KEY_ALIAS=app-signing
