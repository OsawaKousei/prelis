# scripts/macos/.env にコピーして .p12 のパスワードを記入してください。
# 値は文字列として読み込みます。シェルの変数展開やコマンド実行は行いません。
# 値の先頭または末尾に空白がある場合は、全体を引用符で囲んでください。
PRELIS_APPSTORE_P12_PASSWORD=
# インストーラ用 .p12 のパスワードが異なる場合だけ指定してください。
# 未指定なら PRELIS_APPSTORE_P12_PASSWORD を使用します。
# PRELIS_APPSTORE_INSTALLER_P12_PASSWORD=
# App Store Connect へのアップロード用。Mac 上の
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 を参照します。
PRELIS_APPSTORE_API_KEY_ID=
PRELIS_APPSTORE_API_ISSUER_ID=
# GitHub Releases 向け Developer ID Application .p12 のパスワード
PRELIS_GITHUB_P12_PASSWORD=
