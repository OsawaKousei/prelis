# scripts/macos/.env にコピーし、chmod 600 で所有者だけが読めるようにします。
# 値はデータとして扱い、シェルの変数展開・コマンド実行は行いません。
# 環境変数が優先されます。証明書パスは絶対パスか ~/ で指定します。
# 接続先は user@host、作業パスはホーム相対または絶対パス（空白なし）です。
PRELIS_MACOS_SSH_HOST=
PRELIS_MACOS_REMOTE_ROOT=
# Mac 上の Xcode の Developer ディレクトリ。未指定なら OS の選択に従います。
PRELIS_MACOS_DEVELOPER_DIR=
# Apple Developer の Team ID
PRELIS_MACOS_TEAM_ID=
# GitHub Releases 向け Developer ID Application の証明書と署名 ID
PRELIS_MACOS_GITHUB_CERTIFICATE=
PRELIS_MACOS_GITHUB_SIGNING_IDENTITY=
PRELIS_GITHUB_P12_PASSWORD=
# Mac App Store 向けの証明書・Profile と署名 ID
PRELIS_MACOS_APPSTORE_CERTIFICATE=
PRELIS_MACOS_APPSTORE_SIGNING_IDENTITY=
PRELIS_MACOS_INSTALLER_CERTIFICATE=
PRELIS_MACOS_INSTALLER_SIGNING_IDENTITY=
PRELIS_MACOS_APPSTORE_PROFILE=
PRELIS_APPSTORE_P12_PASSWORD=
# 未指定なら Apple Distribution 用のパスワードを使用します。
PRELIS_APPSTORE_INSTALLER_P12_PASSWORD=
# .p8 は Mac の ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 に置きます。
PRELIS_APPSTORE_API_KEY_ID=
PRELIS_APPSTORE_API_ISSUER_ID=
