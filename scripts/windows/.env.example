# Azure Artifact Signing credentials (Ubuntu: KEY=value, not PowerShell $env:KEY syntax)
AZURE_TENANT_ID=<TENANT_ID>
AZURE_CLIENT_ID=<APPLICATION_CLIENT_ID>
AZURE_CLIENT_SECRET=<CLIENT_SECRET>

# Use the endpoint for the region of your Artifact Signing account.
AZURE_ARTIFACT_SIGNING_ENDPOINT=https://<region>.codesigning.azure.net
AZURE_ARTIFACT_SIGNING_ACCOUNT_NAME=<ACCOUNT_NAME>
AZURE_ARTIFACT_SIGNING_CERTIFICATE_PROFILE_NAME=<CERTIFICATE_PROFILE_NAME>
