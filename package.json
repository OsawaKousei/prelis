{
  "name": "prelis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run tauri -w apps/desktop -- dev",
    "dev:web": "npm run dev -w apps/web",
    "build:desktop": "npm run tauri -w apps/desktop -- build",
    "build:web": "npm run build -w apps/web",
    "build:desktop:debug": "npm run tauri -w apps/desktop -- build --debug --no-bundle",
    "start:mobile": "npm run start -w apps/mobile --",
    "android": "npm run android -w apps/mobile --",
    "build:android": "node scripts/android/android-gradle.mjs :app:assembleDebug",
    "build:android:standalone": "node scripts/android/android-gradle.mjs :app:assembleStandalone",
    "build:android:play": "node scripts/android/build-release.mjs play",
    "build:android:github": "node scripts/android/build-release.mjs github",
    "build:android:all": "bash scripts/android/build-all.sh",
    "ios": "npm run ios -w apps/mobile",
    "build:core": "npm run build -w packages/core",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w apps/mobile",
    "test": "npm run test -w apps/mobile -- --runInBand",
    "test:web": "npm test -w apps/web",
    "check": "npm run typecheck && npm run lint && npm test -- --no-watchman && npm run test:web"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
